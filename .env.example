# Порт сервера (по умолчанию 3000)
PORT=3000

# Секрет сессии (обязательно поменяйте для продакшена)
SESSION_SECRET="change_me"

# Показывать OTP в интерфейсе (только для теста; в продакшене выключить)
EXPOSE_OTP="1"

# Ключ администратора для погашения реальных наград (/api/shop/redeem)
ADMIN_KEY="change_me_too"

# Для продакшена можно задать:
# NODE_ENV="production"
